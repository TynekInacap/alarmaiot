<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AlarmaIoT" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/on_brand_container</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="AlarmaIoT.Card" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_marginTop">12dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="AlarmaIoT.SectionTitle" parent="">
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
</resources>
