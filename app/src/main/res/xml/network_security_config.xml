<?xml version="1.0" encoding="utf-8"?>
<!-- Prohíbe tráfico sin cifrar y confía solo en las autoridades certificadoras del sistema -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
